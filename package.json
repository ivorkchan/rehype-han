{
  "name": "rehype-han",
  "version": "0.2.0",
  "description": "Rehype plugin to wrap text segments with proper tags.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "keywords": [
    "rehype",
    "rehype-plugin",
    "unist",
    "hast",
    "latin",
    "cjk"
  ],
  "license": "MIT",
  "author": "ivorkchan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivorkchan/rehype-han.git"
  },
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown"
  },
  "dependencies": {
    "@types/hast": "^3.0.5",
    "unist-util-visit-parents": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5"
  }
}
